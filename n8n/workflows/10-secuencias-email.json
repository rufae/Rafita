{
  "name": "Rafita · 10 Secuencias · Email seguimiento (09:30)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 30
            }
          ]
        }
      },
      "id": "d4000010-0000-4000-8000-000000000001",
      "name": "Cada dia 09:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst secret = 'PEGA_AQUI_TU_WEBHOOK_SECRET';\nconst body = JSON.stringify({ dry_run: false, max_envios: 3 });\nconst signature = crypto.createHmac('sha256', secret).update(body).digest('hex');\nreturn [{ json: { body, signature } }];"
      },
      "id": "d4000010-0000-4000-8000-000000000002",
      "name": "Firmar HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://rafita-agent-core:8000/automation/sequences-run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {}
      },
      "id": "d4000010-0000-4000-8000-000000000003",
      "name": "Rafita secuencias",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Solo avisa si hubo envios o secuencias detenidas por respuesta.\nconst r = $input.first().json;\nif (!r.changes) { return []; }\nreturn [{ json: { chat_id: Number('PEGA_AQUI_TU_CHAT_ID'), text: r.message, parse_mode: 'Markdown' } }];"
      },
      "id": "d4000010-0000-4000-8000-000000000004",
      "name": "Solo si cambios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/botPEGA_AQUI_TU_BOT_TOKEN/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "d4000010-0000-4000-8000-000000000005",
