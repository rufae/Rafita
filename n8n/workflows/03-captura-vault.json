{
  "name": "Rafita · 3 Boveda · Captura (webhook)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "captura-vault",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "b2000003-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "call_workflow",
        "source": "database",
        "workflowId": {
          "value": "__SUB__:Rafita · Sub · Autenticación"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "b2000003-0000-4000-8000-000000000002",
      "name": "Firmar HMAC",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.RAFITA_URL || 'http://rafita-agent-core:8000') + '/automation/capture' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 30000
        },
        "contentType": "raw"
      },
      "id": "b2000003-0000-4000-8000-000000000003",
      "name": "Rafita captura",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Contexto del informe de ejecucion (D14): la firma y el POST\n// viven en Rafita · Sub · Logs; aqui solo se monta el report.\nconst j = $input.first().json;\nconst error = j && j.error;\nreturn [{ json: { report: {\n  execution_id: $execution.id,\n  workflow: $workflow.name,\n  status: error ? 'error' : 'ok',\n  severity: error ? 'error' : 'info',\n  error: error ? String(error.message || error.description || JSON.stringify(error)).slice(0, 400) : undefined,\n  finished_at: new Date().toISOString(),\n} } }];"
      },
      "id": "b2000003-0000-4000-8000-0000000000E1",
      "name": "Firmar informe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        240
      ]
    },
    {
      "parameters": {
        "operation": "call_workflow",
        "source": "database",
        "workflowId": {
          "value": "__SUB__:Rafita · Sub · Logs"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "b2000003-0000-4000-8000-0000000000E2",
      "name": "Reportar a Rafita",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        660,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "manual-captura-vault",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "135387eb-1d2b-4857-b1be-2fd6cc5b17f1",
      "name": "Manual (chat)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Cuerpo normalizado de la captura (text, title, tags, source); la firma\n// y el HMAC viven en Rafita · Sub · Autenticación.\nconst data = $input.first().json.body || {};\nreturn [{ json: { payload: {\n  text: data.text || '',\n  title: data.title || '',\n  tags: data.tags || [],\n  source: data.source || 'n8n',\n} } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "d14-662c74842792e74e",
      "name": "Payload captura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
