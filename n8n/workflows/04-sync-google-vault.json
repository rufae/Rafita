{
  "name": "Rafita · 4 Google · Sync boveda (cada hora)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "b2000006-0000-4000-8000-000000000001",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "call_workflow",
        "source": "database",
        "workflowId": {
          "value": "__SUB__:Rafita · Sub · Autenticación"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "b2000006-0000-4000-8000-000000000002",
      "name": "Firmar HMAC",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.RAFITA_URL || 'http://rafita-agent-core:8000') + '/automation/sync' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b2000006-0000-4000-8000-000000000003",
      "name": "Rafita sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Solo avisa si hubo cambios (tareas/eventos creados, movidos o completados).\nconst r = $input.first().json;\nif (!r.changes) { return []; }\nreturn [{ json: { chat_id: Number($env.RAFITA_CHAT_ID || '0'), text: '🔄 *Sync Google <-> bóveda:* ' + r.message, parse_mode: 'Markdown', disable_web_page_preview: true } }];"
      },
      "id": "b2000006-0000-4000-8000-000000000004",
      "name": "Solo si cambios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "call_workflow",
        "source": "database",
        "workflowId": {
          "value": "__SUB__:Rafita · Sub · Telegram"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "b2000006-0000-4000-8000-000000000005",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Contexto del informe de ejecucion (D14): la firma y el POST\n// viven en Rafita · Sub · Logs; aqui solo se monta el report.\nconst j = $input.first().json;\nconst error = j && j.error;\nreturn [{ json: { report: {\n  execution_id: $execution.id,\n  workflow: $workflow.name,\n  status: error ? 'error' : 'ok',\n  severity: error ? 'error' : 'info',\n  error: error ? String(error.message || error.description || JSON.stringify(error)).slice(0, 400) : undefined,\n  finished_at: new Date().toISOString(),\n} } }];"
      },
      "id": "b2000006-0000-4000-8000-0000000000E1",
      "name": "Firmar informe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        240
      ]
    },
    {
      "parameters": {
        "operation": "call_workflow",
        "source": "database",
        "workflowId": {
          "value": "__SUB__:Rafita · Sub · Logs"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "b2000006-0000-4000-8000-0000000000E2",
      "name": "Reportar a Rafita",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        660,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "manual-sync-google-vault",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "97fb45c1-c49a-4e77-93cc-d1c80a8292f3",
      "name": "Manual (chat)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        -200
      ]
    }
  ],
  "connections": {
    "Cada hora": {
      "main": [
        [
          {
            "node": "Firmar HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Firmar HMAC": {
      "main": [
        [
          {
            "node": "Rafita sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rafita sync": {
      "main": [
        [
          {
            "node": "Solo si cambios",
            "type": "main",
            "index": 0
          },
          {
            "node": "Firmar informe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Solo si cambios": {
      "main": [
        [
          {
            "node": "Enviar Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Firmar informe": {
      "main": [
        [
          {
            "node": "Reportar a Rafita",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual (chat)": {
      "main": [
        [
          {
            "node": "Firmar HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__SUB__:Rafita · Sub · Errores"
  }
}
