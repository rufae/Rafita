{
  "name": "Rafita · 4 Google · Sync boveda (cada hora)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "b2000006-0000-4000-8000-000000000001",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst secret = 'PEGA_AQUI_TU_WEBHOOK_SECRET';\nconst body = JSON.stringify({});\nconst signature = crypto.createHmac('sha256', secret).update(body).digest('hex');\nreturn [{ json: { body, signature } }];"
      },
      "id": "b2000006-0000-4000-8000-000000000002",
      "name": "Firmar HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://rafita-agent-core:8000/automation/sync",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {}
      },
      "id": "b2000006-0000-4000-8000-000000000003",
      "name": "Rafita sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Solo avisa si hubo cambios (tareas/eventos creados, movidos o completados).\nconst r = $input.first().json;\nif (!r.changes) { return []; }\nreturn [{ json: { chat_id: Number('PEGA_AQUI_TU_CHAT_ID'), text: '🔄 *Sync Google <-> bóveda:* ' + r.message, parse_mode: 'Markdown' } }];"
      },
      "id": "b2000006-0000-4000-8000-000000000004",
      "name": "Solo si cambios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/botPEGA_AQUI_TU_BOT_TOKEN/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "b2000006-0000-4000-8000-000000000005",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    }
  ],
  "connections": {
    "Cada hora": {
      "main": [
        [
          {
            "node": "Firmar HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Firmar HMAC": {
      "main": [
        [
          {
            "node": "Rafita sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rafita sync": {
      "main": [
        [
          {
            "node": "Solo si cambios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Solo si cambios": {
      "main": [
        [
          {
            "node": "Enviar Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
