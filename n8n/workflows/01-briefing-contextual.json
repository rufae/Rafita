        "jsCode": "// Firma la peticion de nota de voz (mismo texto del briefing).\nconst crypto = require('crypto');\nconst secret = 'PEGA_AQUI_TU_WEBHOOK_SECRET';\nconst briefing = $('Mensaje Telegram').first().json;\nconst body = JSON.stringify({ text: briefing.text, chat_id: briefing.chat_id });\nconst signature = crypto.createHmac('sha256', secret).update(body).digest('hex');\nreturn [{ json: { body, signature } }];"
      },
