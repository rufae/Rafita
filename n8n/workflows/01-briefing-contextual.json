        "jsCode": "// Fallo controlado: sin texto no se avisa (evita spam con 'undefined').\nif (!r || !r.text) { return []; }\n// Construye el mensaje de Telegram: botones URL o de accion (callback).\nconst r = $input.first().json;\nconst fila = (r.buttons || []).map(b => b.callback\n  ? { text: b.text, callback_data: b.callback }\n  : { text: b.text, url: b.url });\nreturn [{ json: { chat_id: Number('PEGA_AQUI_TU_CHAT_ID'), text: r.text, parse_mode: 'Markdown', reply_markup: fila.length ? { inline_keyboard: [fila] } : undefined } }];"
      },
