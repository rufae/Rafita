        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b2000004-0000-4000-8000-000000000003",
      "name": "Rafita radar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Solo avisa si hay radar real: si el backend falla o no hay texto,\n// no se manda 'text: undefined' a Telegram (plan de calidad 2026-10-04).\nconst r = $input.first().json;\nif (!r || r.success === false || !r.text) { return []; }\nreturn [{ json: { chat_id: Number($env.RAFITA_CHAT_ID || '0'), text: r.text, parse_mode: 'Markdown', disable_web_page_preview: true } }];"
      },
      "id": "b2000004-0000-4000-8000-000000000005",
      "name": "Solo si hay radar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "call_workflow",
        "source": "database",
        "workflowId": {
          "value": "__SUB__:Rafita · Sub · Telegram"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "b2000004-0000-4000-8000-000000000004",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Contexto del informe de ejecucion (D14): la firma y el POST\n// viven en Rafita · Sub · Logs; aqui solo se monta el report.\nconst j = $input.first().json;\nconst error = j && j.error;\nreturn [{ json: { report: {\n  execution_id: $execution.id,\n  workflow: $workflow.name,\n  status: error ? 'error' : 'ok',\n  severity: error ? 'error' : 'info',\n  error: error ? String(error.message || error.description || JSON.stringify(error)).slice(0, 400) : undefined,\n  finished_at: new Date().toISOString(),\n} } }];"
      },
      "id": "b2000004-0000-4000-8000-0000000000E1",
      "name": "Firmar informe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
