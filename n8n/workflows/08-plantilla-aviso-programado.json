{
  "name": "Rafita · 8 Plantillas · Aviso programado (ejemplo)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1000001-0000-4000-8000-000000000001",
      "name": "Cada dia 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "call_workflow",
        "source": "database",
        "workflowId": {
          "value": "__SUB__:Rafita · Sub · Autenticación"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "a1000001-0000-4000-8000-000000000002",
      "name": "Firmar HMAC",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.RAFITA_URL || 'http://rafita-agent-core:8000') + '/webhook/n8n' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 600000
        },
        "contentType": "raw"
      },
      "id": "a1000001-0000-4000-8000-000000000003",
      "name": "Enviar a Rafita",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Contexto del informe de ejecucion (D14): la firma y el POST\n// viven en Rafita · Sub · Logs; aqui solo se monta el report.\nconst j = $input.first().json;\nconst error = j && j.error;\nreturn [{ json: { report: {\n  execution_id: $execution.id,\n  workflow: $workflow.name,\n  status: error ? 'error' : 'ok',\n  severity: error ? 'error' : 'info',\n  error: error ? String(error.message || error.description || JSON.stringify(error)).slice(0, 400) : undefined,\n  finished_at: new Date().toISOString(),\n} } }];"
      },
      "id": "a1000001-0000-4000-8000-0000000000E1",
      "name": "Firmar informe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        240
      ]
    },
    {
      "parameters": {
        "operation": "call_workflow",
        "source": "database",
        "workflowId": {
          "value": "__SUB__:Rafita · Sub · Logs"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "a1000001-0000-4000-8000-0000000000E2",
      "name": "Reportar a Rafita",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        660,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "manual-plantilla-aviso",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "21cb5c05-9255-469b-aadb-bc382a904e93",
      "name": "Manual (chat)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Payload del aviso (chat_id de $env); la firma vive en Sub · Autenticación.\n// Config por entorno (D13): WEBHOOK_SECRET y RAFITA_CHAT_ID los inyecta\n// docker-compose.n8n.yml en el contenedor n8n; nada que horneear aqui.\nconst payload = {\n  chat_id: Number($env.RAFITA_CHAT_ID || '0'),\n  message: '⏰ Aviso de n8n: esto es un ejemplo de notificacion proactiva.',\n};\nreturn [{ json: { payload: payload } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "d14-3932812d6c03da17",
      "name": "Payload aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        0
      ]
    }
  ],
  "connections": {
    "Cada dia 09:00": {
      "main": [
        [
          {
            "node": "Payload aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Firmar HMAC": {
      "main": [
        [
          {
            "node": "Enviar a Rafita",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar a Rafita": {
      "main": [
        [
          {
            "node": "Firmar informe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Firmar informe": {
      "main": [
        [
          {
            "node": "Reportar a Rafita",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual (chat)": {
      "main": [
        [
          {
            "node": "Payload aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Payload aviso": {
      "main": [
        [
          {
            "node": "Firmar HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__SUB__:Rafita · Sub · Errores"
  }
}
