{
  "name": "Rafita · 8 Plantillas · Aviso programado (ejemplo)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1000001-0000-4000-8000-000000000001",
      "name": "Cada dia 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Firma HMAC del cuerpo, exactamente como lo espera el gateway de Rafita.\n// 1) Cambia 'PEGA_AQUI_TU_WEBHOOK_SECRET' por el valor de WEBHOOK_SECRET\n//    del .env del HP.\n// 2) Cambia chat_id por tu id de Telegram (ADMIN_IDS del .env).\nconst crypto = require('crypto');\nconst secret = 'PEGA_AQUI_TU_WEBHOOK_SECRET';\nconst payload = {\n  chat_id: PEGA_AQUI_TU_CHAT_ID,\n  message: '⏰ Aviso de n8n: esto es un ejemplo de notificacion proactiva.',\n};\nconst body = JSON.stringify(payload);\nconst signature = crypto.createHmac('sha256', secret).update(body).digest('hex');\nreturn [{ json: { body, signature } }];"
      },
      "id": "a1000001-0000-4000-8000-000000000002",
      "name": "Firmar HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://rafita-agent-core:8000/webhook/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {},
        "contentType": "raw"
      },
      "id": "a1000001-0000-4000-8000-000000000003",
      "name": "Enviar a Rafita",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
    "Cada dia 09:00": {
      "main": [
        [
          {
            "node": "Firmar HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Firmar HMAC": {
      "main": [
        [
          {
            "node": "Enviar a Rafita",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
