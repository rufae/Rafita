{
  "name": "Rafita · 2 Correo · Inbox Zero (cada 30 min)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "b2000002-0000-4000-8000-000000000001",
      "name": "Cada 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Firma HMAC de la peticion al gateway de Rafita.\nconst crypto = require('crypto');\nconst secret = 'PEGA_AQUI_TU_WEBHOOK_SECRET';\nconst body = JSON.stringify({ hours: 2, max_results: 8 });\nconst signature = crypto.createHmac('sha256', secret).update(body).digest('hex');\nreturn [{ json: { body, signature } }];"
      },
      "id": "b2000002-0000-4000-8000-000000000002",
      "name": "Firmar HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://rafita-agent-core:8000/automation/inbox-scan",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {},
        "contentType": "raw"
      },
      "id": "b2000002-0000-4000-8000-000000000003",
      "name": "Rafita inbox-scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Solo avisa si hay correos urgentes o de clientes, con boton de respuesta.\nconst r = $input.first().json;\nif (!r.urgent_count) { return []; }\nconst items = (r.items || []).filter(i => i.categoria === 'urgente' || i.categoria === 'cliente');\nconst lineas = items.map(i => `*${i.categoria.toUpperCase()}* — ${i.subject} (de ${i.from})` + (i.borrador ? `\\n_borrador:_ ${i.borrador}` : '')).join('\\n\\n');\nconst text = `📥 *Inbox:* ${items.length} correo(s) que requieren atencion\\n\\n${lineas}`;\nconst botones = items.filter(i => i.token).slice(0, 4).map(i => [{ text: '✉️ Responder: ' + (i.from.split('<')[0].trim().slice(0, 18) || 'remitente'), callback_data: 'inbox_send:' + i.token }]);\nreturn [{ json: { chat_id: Number('PEGA_AQUI_TU_CHAT_ID'), text, parse_mode: 'Markdown', reply_markup: botones.length ? { inline_keyboard: botones } : undefined } }];"
      },
      "id": "b2000002-0000-4000-8000-000000000004",
      "name": "Solo si urgente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/botPEGA_AQUI_TU_BOT_TOKEN/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "b2000002-0000-4000-8000-000000000005",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    }
  ],
  "connections": {
    "Cada 30 min": {
      "main": [
        [
          {
            "node": "Firmar HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Firmar HMAC": {
      "main": [
        [
          {
            "node": "Rafita inbox-scan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rafita inbox-scan": {
      "main": [
        [
          {
            "node": "Solo si urgente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Solo si urgente": {
      "main": [
        [
          {
            "node": "Enviar Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
