{
  "name": "Rafita · 2 Correo · Inbox Zero (cada 30 min)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "b2000002-0000-4000-8000-000000000001",
      "name": "Cada 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "call_workflow",
        "source": "database",
        "workflowId": {
          "value": "__SUB__:Rafita · Sub · Autenticación"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "b2000002-0000-4000-8000-000000000002",
      "name": "Firmar HMAC",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.RAFITA_URL || 'http://rafita-agent-core:8000') + '/automation/inbox-scan' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 30000
        },
        "contentType": "raw"
      },
      "id": "b2000002-0000-4000-8000-000000000003",
      "name": "Rafita inbox-scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Solo avisa si hay correos urgentes o de clientes, con boton de respuesta.\nconst r = $input.first().json;\nif (!r || r.notify !== true) { return []; }\nconst items = (r.items || []).filter(i => i.categoria === 'urgente' || i.categoria === 'cliente');\nconst lineas = items.map(i => `*${i.categoria.toUpperCase()}* — ${i.subject} (de ${i.from})` + (i.borrador ? `\\n_borrador:_ ${i.borrador}` : '')).join('\\n\\n');\nconst text = `📥 *Inbox:* ${items.length} correo(s) que requieren atencion\\n\\n${lineas}`;\nconst botones = items.filter(i => i.token).slice(0, 4).map(i => [{ text: '✉️ Responder: ' + (i.from.split('<')[0].trim().slice(0, 18) || 'remitente'), callback_data: 'inbox_send:' + i.token }]);\nreturn [{ json: { chat_id: Number($env.RAFITA_CHAT_ID || '0'), text, parse_mode: 'Markdown', disable_web_page_preview: true, reply_markup: botones.length ? { inline_keyboard: botones } : undefined } }];"
      },
      "id": "b2000002-0000-4000-8000-000000000004",
      "name": "Solo si urgente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "call_workflow",
        "source": "database",
        "workflowId": {
          "value": "__SUB__:Rafita · Sub · Telegram"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "b2000002-0000-4000-8000-000000000005",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Contexto del informe de ejecucion (D14): la firma y el POST\n// viven en Rafita · Sub · Logs; aqui solo se monta el report.\nconst j = $input.first().json;\nconst error = j && j.error;\nreturn [{ json: { report: {\n  execution_id: $execution.id,\n  workflow: $workflow.name,\n  status: error ? 'error' : 'ok',\n  severity: error ? 'error' : 'info',\n  error: error ? String(error.message || error.description || JSON.stringify(error)).slice(0, 400) : undefined,\n  finished_at: new Date().toISOString(),\n} } }];"
      },
      "id": "b2000002-0000-4000-8000-0000000000E1",
      "name": "Firmar informe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        240
      ]
    },
    {
      "parameters": {
        "operation": "call_workflow",
        "source": "database",
        "workflowId": {
          "value": "__SUB__:Rafita · Sub · Logs"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "b2000002-0000-4000-8000-0000000000E2",
      "name": "Reportar a Rafita",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        660,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "manual-inbox-zero",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "2c465173-afd9-400d-ab10-71ff7a8e470a",
      "name": "Manual (chat)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Payload de la peticion al gateway (la firma vive en Sub · Autenticación).\nreturn [{ json: { payload: { hours: 2, max_results: 8 } } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "d14-556e164dd7ca5d20",
      "name": "Payload inbox",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        0
      ]
    }
  ],
  "connections": {
