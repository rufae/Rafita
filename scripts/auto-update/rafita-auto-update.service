[Unit]
Description=Autoactualizacion diaria del nodo (Rafita + projects.conf): git, build, health check y rollback
Documentation=file:///home/server/proyectos/rafita/docs/runbook.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=server
Group=docker
ExecStart=/home/server/proyectos/rafita/scripts/auto_update.sh
TimeoutStartSec=30min
