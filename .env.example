# === TELEGRAM ===
# Token del bot de Telegram (obtenlo de @BotFather en Telegram)
TELEGRAM_TOKEN=tu_token_aqui

# IDs de administradores (separados por coma)
ADMIN_IDS=123456789,987654321

# === ASISTENTE ===
# Nombre del asistente (aparece en respuestas y logs)
# Cambialo por el nombre que quieras darle a tu instancia
ASSISTANT_NAME=Rafita

# === OLLAMA / LLM ===
# Host interno de Ollama (no cambiar si usas docker-compose)
OLLAMA_HOST=http://ollama:11434

# Modelo de chat (debe estar descargado en Ollama)
# Recomendado: qwen2.5:7b (CPU/GPU baja), gemma4:12b (GPU >=10GB VRAM)
OLLAMA_MODEL=qwen2.5:7b

# Modelo de vision (debe estar descargado en Ollama)
OLLAMA_VISION_MODEL=llava:7b

# Esfuerzo de razonamiento en modelos que "piensan" (gemma4, deepseek-r1...).
# none lo desactiva: sin esto el razonamiento consume los tokens de respuesta
# y el contenido visible llega vacio. Valores: none, low, medium, high.
# Vacio = no enviar el parametro (comportamiento del modelo por defecto).
OLLAMA_REASONING_EFFORT=none

# Hilos de CPU para inferencia (0 = automatico segun hardware)
OLLAMA_NUM_THREAD=0

# Techo de espera por respuesta del LLM en segundos (corte de red silencioso).
# Las conexiones rechazadas fallan en segundos; esto acota el caso de paquetes
# descartados. Subir si se generan respuestas muy largas en CPU.
OLLAMA_REQUEST_TIMEOUT=600

# Nodo con GPU opcional (torre): si esta encendido y accesible se usa para el
# chat; si no, se usa OLLAMA_HOST automaticamente. Vacio = desactivado.
# Ejemplo: OLLAMA_GPU_HOST=http://100.97.252.19:11435
OLLAMA_GPU_HOST=
# Cada cuantos segundos se comprueba si la torre esta disponible (min 10)
OLLAMA_GPU_PROBE_INTERVAL=60

# Formato de logs: text (humano) o json (estructurado, una linea por evento).
# En ambos casos los secretos se redactan antes de escribir.
LOG_FORMAT=text

# Temperatura del modelo (0.0 - 2.0)
LLM_TEMPERATURE=0.7

# Maximo de tokens de respuesta
LLM_MAX_TOKENS=4096

# === ALMACENAMIENTO LOCAL ===
DATA_DIR=/data
DB_PATH=/data/db/rafita.db
EXCEL_DIR=/data/excels
EXPORT_DIR=/data/exports
LOG_DIR=/data/logs

# === COMPORTAMIENTO ===
# Idioma de las respuestas y del STT: es (por defecto) o en
LANGUAGE=es
TIMEZONE=America/Mexico_City
MAX_HISTORY_PER_CHAT=50
CLEANUP_INTERVAL=3600
CHAT_INACTIVITY_TIMEOUT=86400

# === FINANZAS ===
DEFAULT_CURRENCY=MXN

# === VOZ / WHISPER ===
WHISPER_MODEL=tiny

# === TRABAJADOR PROACTIVO ===
PROACTIVE_CHECK_TIME=09:00

# === BACKUPS ===
BACKUP_RETENTION_DAYS=30

# === RAG / SEGUNDO CEREBRO ===
# Modelo de embeddings (debe estar descargado en Ollama)
# nomic-embed-text: 274MB, 768d, rapido, aceptable en espanol
# bge-m3: 1.2GB, 1024d, excelente multilingue (recomendado con GPU)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# Nombre del vault de Obsidian (para enlaces obsidian://)
OBSIDIAN_VAULT_NAME=mi_boveda_obsidian

# Ruta al vault dentro del contenedor
OBSIDIAN_VAULT_DIR=/data/obsidian_vault

# Tamano de chunk y solape para indexacion
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Umbral minimo de relevancia (similitud coseno) para devolver fragmentos del RAG.
# Calibrado en la tarea 1.5: 0.49 da 0 falsos positivos y 3/28 falsos negativos
# en el dataset de evaluacion. Bajarlo devuelve ruido; subirlo pierde aciertos.
RELEVANCE_THRESHOLD=0.49

# Modo depuracion del segundo cerebro: false prohibe escribir en Obsidian
# (manage_obsidian_note create/append/delete, move_or_rename_file, ingest_file
# y el diario automatico). La lectura y el RAG siguen funcionando.
PERSIST_TO_BRAIN=true

# BrainMaintainer (versionado git local del vault). Desactivado por defecto.
# Al activarlo hace snapshots periodicos; las carpetas protegidas se configuran
# en agent/config.yml (vault.protected_folders).
BRAIN_MAINTENANCE=false
BRAIN_MAINTENANCE_INTERVAL=1800

# === PROVEEDOR DE IA ===
# ollama (local, por defecto) u openai (cualquier endpoint compatible OpenAI:
# OpenAI, DeepSeek, Groq, OpenRouter, vLLM...).
AI_PROVIDER=ollama
# Solo para AI_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=
OPENAI_EMBEDDING_MODEL=

# Opcional: esfuerzo de razonamiento para endpoints compatibles (p. ej.
# OPENAI_BASE_URL apuntando a Ollama /v1 con un modelo que piensa).
# Vacio = no enviar el parametro.
OPENAI_REASONING_EFFORT=

# Directorio de ChromaDB
VECTOR_DB_DIR=/data/vector_db

# Intervalo del indexador en segundo plano (segundos)
INDEXER_INTERVAL=300

# === OBSIDIAN MCP ===
# API key del plugin "Local REST API with MCP" en Obsidian
OBSIDIAN_API_KEY=

# === SEGURIDAD ===
# Clave de encriptacion Fernet (se autogenera si esta vacia)
ENCRYPTION_KEY=

# Secreto HMAC para webhooks entrantes. Si esta vacio, se genera uno aleatorio
# unico por instancia en el primer arranque y se guarda en .env. Sin secreto,
# los endpoints de webhook rechazan las peticiones (fail-closed).
WEBHOOK_SECRET=
